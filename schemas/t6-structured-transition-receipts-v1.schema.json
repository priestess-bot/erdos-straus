{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/priestess-bot/erdos_straus/schemas/t6-structured-transition-receipts-v1.schema.json",
  "title": "T6 Structured E1-E5 Transition Receipt Bundle V1",
  "$ref": "#/$defs/VerifiedTransitionBundleV1",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "pathSegment": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "coordinates": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 7,
      "maxItems": 7
    },
    "potentialReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "state_id",
        "coordinates",
        "digest"
      ],
      "properties": {
        "schema_id": {
          "const": "t5_n7_potential_receipt_v1"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "state_id": {
          "$ref": "#/$defs/identifier"
        },
        "coordinates": {
          "$ref": "#/$defs/coordinates"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "E1OccurrenceReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type",
        "schema_version",
        "source_state_id",
        "source_state_digest",
        "parent_transition_id",
        "parent_transition_digest",
        "producer_id",
        "producer_digest",
        "branch_id",
        "scope",
        "occurrence_path",
        "occurrence_value",
        "provenance_digest",
        "source_terminal_schedule_id",
        "source_terminal_schedule_digest",
        "source_terminal_result",
        "source_terminal_result_digest",
        "claim_id",
        "claim_digest",
        "reproduction_id",
        "reproduction_digest",
        "independent_verifier_id",
        "independent_verifier_digest",
        "digest"
      ],
      "properties": {
        "receipt_type": {
          "const": "E1OccurrenceReceiptV1"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "source_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_state_digest": {
          "$ref": "#/$defs/digest"
        },
        "parent_transition_id": {
          "$ref": "#/$defs/identifier"
        },
        "parent_transition_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "const": "ROOT_INITIALIZER"
            }
          ]
        },
        "producer_id": {
          "$ref": "#/$defs/identifier"
        },
        "producer_digest": {
          "$ref": "#/$defs/digest"
        },
        "branch_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope": {
          "$ref": "#/$defs/identifier"
        },
        "occurrence_path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathSegment"
          }
        },
        "occurrence_value": true,
        "provenance_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_terminal_schedule_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_terminal_schedule_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_terminal_result": {
          "const": "MISS_COMPLETE"
        },
        "source_terminal_result_digest": {
          "$ref": "#/$defs/digest"
        },
        "claim_id": {
          "$ref": "#/$defs/identifier"
        },
        "claim_digest": {
          "$ref": "#/$defs/digest"
        },
        "reproduction_id": {
          "$ref": "#/$defs/identifier"
        },
        "reproduction_digest": {
          "$ref": "#/$defs/digest"
        },
        "independent_verifier_id": {
          "$ref": "#/$defs/identifier"
        },
        "independent_verifier_digest": {
          "$ref": "#/$defs/digest"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "E2ProjectionReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type",
        "schema_version",
        "source_state_id",
        "source_state_digest",
        "producer_id",
        "branch_id",
        "candidate_witness_digest",
        "projector_id",
        "projector_digest",
        "tie_break_rule_id",
        "tie_break_rule_digest",
        "canonical_target_payload",
        "target_projection_digest",
        "digest"
      ],
      "properties": {
        "receipt_type": {
          "const": "E2ProjectionReceiptV1"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "source_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_state_digest": {
          "$ref": "#/$defs/digest"
        },
        "producer_id": {
          "$ref": "#/$defs/identifier"
        },
        "branch_id": {
          "$ref": "#/$defs/identifier"
        },
        "candidate_witness_digest": {
          "$ref": "#/$defs/digest"
        },
        "projector_id": {
          "$ref": "#/$defs/identifier"
        },
        "projector_digest": {
          "$ref": "#/$defs/digest"
        },
        "tie_break_rule_id": {
          "$ref": "#/$defs/identifier"
        },
        "tie_break_rule_digest": {
          "$ref": "#/$defs/digest"
        },
        "canonical_target_payload": {
          "type": "object"
        },
        "target_projection_digest": {
          "$ref": "#/$defs/digest"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "E3TypingReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type",
        "schema_version",
        "target_state_id",
        "target_projection_digest",
        "target_schema_id",
        "target_schema_version",
        "normal_form_verifier_id",
        "normal_form_verifier_digest",
        "family_predicate_results",
        "precedence_table_id",
        "precedence_table_digest",
        "owner",
        "owner_digest",
        "grammar_id",
        "grammar_digest",
        "admission_gate_id",
        "admission_gate_version",
        "admission_gate_digest",
        "digest"
      ],
      "properties": {
        "receipt_type": {
          "const": "E3TypingReceiptV1"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "target_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_projection_digest": {
          "$ref": "#/$defs/digest"
        },
        "target_schema_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "normal_form_verifier_id": {
          "$ref": "#/$defs/identifier"
        },
        "normal_form_verifier_digest": {
          "$ref": "#/$defs/digest"
        },
        "family_predicate_results": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "precedence_table_id": {
          "$ref": "#/$defs/identifier"
        },
        "precedence_table_digest": {
          "$ref": "#/$defs/digest"
        },
        "owner": {
          "$ref": "#/$defs/identifier"
        },
        "owner_digest": {
          "$ref": "#/$defs/digest"
        },
        "grammar_id": {
          "$ref": "#/$defs/identifier"
        },
        "grammar_digest": {
          "$ref": "#/$defs/digest"
        },
        "admission_gate_id": {
          "$ref": "#/$defs/identifier"
        },
        "admission_gate_version": {
          "type": "integer",
          "minimum": 1
        },
        "admission_gate_digest": {
          "$ref": "#/$defs/digest"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "E4LiftReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type",
        "schema_version",
        "source_state_id",
        "target_state_id",
        "source_equation_interface",
        "source_equation_interface_digest",
        "target_equation_interface",
        "target_equation_interface_digest",
        "lift_map_id",
        "lift_map_digest",
        "universal_quantifier_statement",
        "symbolic_verifier_id",
        "symbolic_verifier_digest",
        "reproduction_id",
        "reproduction_digest",
        "negative_mutation_ids",
        "digest"
      ],
      "properties": {
        "receipt_type": {
          "const": "E4LiftReceiptV1"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "source_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_equation_interface": true,
        "source_equation_interface_digest": {
          "$ref": "#/$defs/digest"
        },
        "target_equation_interface": true,
        "target_equation_interface_digest": {
          "$ref": "#/$defs/digest"
        },
        "lift_map_id": {
          "$ref": "#/$defs/identifier"
        },
        "lift_map_digest": {
          "$ref": "#/$defs/digest"
        },
        "universal_quantifier_statement": {
          "$ref": "#/$defs/identifier"
        },
        "symbolic_verifier_id": {
          "$ref": "#/$defs/identifier"
        },
        "symbolic_verifier_digest": {
          "$ref": "#/$defs/digest"
        },
        "reproduction_id": {
          "$ref": "#/$defs/identifier"
        },
        "reproduction_digest": {
          "$ref": "#/$defs/digest"
        },
        "negative_mutation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONTROL_AS_ACTUAL_BY_LABEL",
              "LOCAL_MISS_AS_GLOBAL_MISS",
              "SELF_REGISTERED_PRODUCER",
              "SELF_REGISTERED_VALIDATOR",
              "SOURCE_DIGEST_SWAP",
              "OCCURRENCE_PATH_SWAP",
              "CLAIM_HASH_DRIFT",
              "PROJECTOR_HASH_DRIFT",
              "GRAMMAR_HASH_DRIFT",
              "T5_TAXONOMY_DRIFT",
              "PARENT_TRANSITION_REPLAY_BREAK"
            ]
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "E5TicketReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type",
        "schema_version",
        "source_state_id",
        "target_state_id",
        "source_potential_receipt",
        "source_potential_receipt_digest",
        "target_potential_receipt",
        "target_potential_receipt_digest",
        "ticket_type",
        "taxonomy_id",
        "taxonomy_digest",
        "source_coordinates",
        "target_coordinates",
        "first_decreasing_coordinate",
        "comparison_scope",
        "parent_to_final_assertion_digest",
        "digest"
      ],
      "properties": {
        "receipt_type": {
          "const": "E5TicketReceiptV1"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "source_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_potential_receipt": {
          "$ref": "#/$defs/potentialReceipt"
        },
        "source_potential_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "target_potential_receipt": {
          "$ref": "#/$defs/potentialReceipt"
        },
        "target_potential_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "ticket_type": {
          "enum": [
            "OUTER_RANK_DROP",
            "PHASE_DROP",
            "LOCAL_DROP"
          ]
        },
        "taxonomy_id": {
          "$ref": "#/$defs/identifier"
        },
        "taxonomy_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_coordinates": {
          "$ref": "#/$defs/coordinates"
        },
        "target_coordinates": {
          "$ref": "#/$defs/coordinates"
        },
        "first_decreasing_coordinate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "comparison_scope": {
          "const": "PARENT_TO_FINAL_TARGET"
        },
        "parent_to_final_assertion_digest": {
          "$ref": "#/$defs/digest"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "VerifiedTransitionBundleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type",
        "schema_version",
        "transition_id",
        "source_state_id",
        "source_state_digest",
        "target_state_id",
        "producer_id",
        "branch_id",
        "target_projection_digest",
        "e1_occurrence",
        "e2_projection",
        "e3_typing",
        "e4_lift",
        "e5_ticket",
        "digest"
      ],
      "properties": {
        "receipt_type": {
          "const": "VerifiedTransitionBundleV1"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^transition:[0-9a-f]{64}$"
        },
        "source_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_state_digest": {
          "$ref": "#/$defs/digest"
        },
        "target_state_id": {
          "$ref": "#/$defs/identifier"
        },
        "producer_id": {
          "$ref": "#/$defs/identifier"
        },
        "branch_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_projection_digest": {
          "$ref": "#/$defs/digest"
        },
        "e1_occurrence": {
          "$ref": "#/$defs/E1OccurrenceReceiptV1"
        },
        "e2_projection": {
          "$ref": "#/$defs/E2ProjectionReceiptV1"
        },
        "e3_typing": {
          "$ref": "#/$defs/E3TypingReceiptV1"
        },
        "e4_lift": {
          "$ref": "#/$defs/E4LiftReceiptV1"
        },
        "e5_ticket": {
          "$ref": "#/$defs/E5TicketReceiptV1"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
