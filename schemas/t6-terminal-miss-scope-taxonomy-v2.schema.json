{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://priestess-bot.github.io/erdos-straus/schemas/t6-terminal-miss-scope-taxonomy-v2.schema.json",
  "title": "T6 terminal miss shape-only scope taxonomy v2",
  "oneOf": [
    {"$ref": "#/$defs/RegisteredPriorityPrefixMissReceiptV2"},
    {"$ref": "#/$defs/TerminalUniverseMissReceiptV2"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonemptyText": {
      "type": "string",
      "minLength": 1
    },
    "subjectKind": {
      "enum": ["SOURCE_STATE", "TARGET_PROJECTION"]
    },
    "RegisteredPriorityPrefixMissReceiptV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type",
        "schema_version",
        "head_sha",
        "evidence_class",
        "e1_authority",
        "queue_authority",
        "registry_id",
        "registry_version",
        "registry_digest",
        "schedule_id",
        "schedule_digest",
        "subject_kind",
        "subject_id",
        "subject_digest",
        "scheduler_input_digest",
        "owner_domain_id",
        "owner_domain_digest",
        "domain_membership_replay_id",
        "domain_membership_replay_artifact_digest",
        "domain_membership_replay_digest",
        "ordered_gaps",
        "ordered_family_ids",
        "ordered_family_definition_digests",
        "ordered_local_miss_digests",
        "next_unchecked_gap",
        "coverage_semantics",
        "coverage_theorem_id",
        "coverage_theorem_digest",
        "coverage_reproduction_id",
        "coverage_reproduction_digest",
        "coverage_verifier_id",
        "coverage_verifier_digest",
        "coverage_replay_digest",
        "global_exhaustion",
        "outcome",
        "digest"
      ],
      "properties": {
        "receipt_type": {"const": "RegisteredPriorityPrefixMissReceiptV2"},
        "schema_version": {"const": 2},
        "head_sha": {"$ref": "#/$defs/headSha"},
        "evidence_class": {"const": "EVIDENCE_ONLY_NO_E1_OR_QUEUE_AUTHORITY"},
        "e1_authority": {"const": false},
        "queue_authority": {"const": false},
        "registry_id": {"const": "t6_coordinator_role_registry_v2"},
        "registry_version": {"const": 2},
        "registry_digest": {"$ref": "#/$defs/sha256"},
        "schedule_id": {"$ref": "#/$defs/nonemptyText"},
        "schedule_digest": {"$ref": "#/$defs/sha256"},
        "subject_kind": {"$ref": "#/$defs/subjectKind"},
        "subject_id": {"$ref": "#/$defs/nonemptyText"},
        "subject_digest": {"$ref": "#/$defs/sha256"},
        "scheduler_input_digest": {"$ref": "#/$defs/sha256"},
        "owner_domain_id": {"$ref": "#/$defs/nonemptyText"},
        "owner_domain_digest": {"$ref": "#/$defs/sha256"},
        "domain_membership_replay_id": {"$ref": "#/$defs/nonemptyText"},
        "domain_membership_replay_artifact_digest": {"$ref": "#/$defs/sha256"},
        "domain_membership_replay_digest": {"$ref": "#/$defs/sha256"},
        "ordered_gaps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 3}
        },
        "ordered_family_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonemptyText"}
        },
        "ordered_family_definition_digests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "ordered_local_miss_digests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "next_unchecked_gap": {"type": "integer", "minimum": 3},
        "coverage_semantics": {"const": "REGISTERED_PRIORITY_ONLY"},
        "coverage_theorem_id": {"$ref": "#/$defs/nonemptyText"},
        "coverage_theorem_digest": {"$ref": "#/$defs/sha256"},
        "coverage_reproduction_id": {"$ref": "#/$defs/nonemptyText"},
        "coverage_reproduction_digest": {"$ref": "#/$defs/sha256"},
        "coverage_verifier_id": {"$ref": "#/$defs/nonemptyText"},
        "coverage_verifier_digest": {"$ref": "#/$defs/sha256"},
        "coverage_replay_digest": {"$ref": "#/$defs/sha256"},
        "global_exhaustion": {"const": false},
        "outcome": {"const": "MISS_REGISTERED_PRIORITY_COMPLETE"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "TerminalUniverseMissReceiptV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type",
        "schema_version",
        "head_sha",
        "evidence_class",
        "e1_authority",
        "queue_authority",
        "registry_id",
        "registry_version",
        "registry_digest",
        "terminal_universe_id",
        "terminal_universe_digest",
        "subject_kind",
        "subject_id",
        "subject_digest",
        "scheduler_input_digest",
        "owner_domain_id",
        "owner_domain_digest",
        "domain_membership_replay_id",
        "domain_membership_replay_artifact_digest",
        "domain_membership_replay_digest",
        "root_prime",
        "root_primality_verifier_id",
        "root_primality_verifier_artifact_digest",
        "root_primality_replay_digest",
        "natural_gap_start",
        "natural_gap_stop",
        "natural_gap_step",
        "natural_gap_count",
        "checked_gap_count",
        "checked_divisor_count",
        "hit_count",
        "range_definition_id",
        "range_definition_digest",
        "scan_algorithm_id",
        "scan_algorithm_digest",
        "factorization_verifier_id",
        "factorization_verifier_digest",
        "factorization_manifest_digest",
        "divisor_lattice_manifest_digest",
        "scan_transcript_digest",
        "reverse_equivalence_claim_id",
        "reverse_equivalence_claim_digest",
        "reverse_equivalence_proof_id",
        "reverse_equivalence_proof_digest",
        "reverse_equivalence_verifier_id",
        "reverse_equivalence_verifier_digest",
        "reverse_equivalence_replay_digest",
        "global_exhaustion",
        "outcome",
        "digest"
      ],
      "properties": {
        "receipt_type": {"const": "TerminalUniverseMissReceiptV2"},
        "schema_version": {"const": 2},
        "head_sha": {"$ref": "#/$defs/headSha"},
        "evidence_class": {"const": "EVIDENCE_ONLY_NO_E1_OR_QUEUE_AUTHORITY"},
        "e1_authority": {"const": false},
        "queue_authority": {"const": false},
        "registry_id": {"const": "t6_coordinator_role_registry_v2"},
        "registry_version": {"const": 2},
        "registry_digest": {"$ref": "#/$defs/sha256"},
        "terminal_universe_id": {"$ref": "#/$defs/nonemptyText"},
        "terminal_universe_digest": {"$ref": "#/$defs/sha256"},
        "subject_kind": {"$ref": "#/$defs/subjectKind"},
        "subject_id": {"$ref": "#/$defs/nonemptyText"},
        "subject_digest": {"$ref": "#/$defs/sha256"},
        "scheduler_input_digest": {"$ref": "#/$defs/sha256"},
        "owner_domain_id": {"$ref": "#/$defs/nonemptyText"},
        "owner_domain_digest": {"$ref": "#/$defs/sha256"},
        "domain_membership_replay_id": {"$ref": "#/$defs/nonemptyText"},
        "domain_membership_replay_artifact_digest": {"$ref": "#/$defs/sha256"},
        "domain_membership_replay_digest": {"$ref": "#/$defs/sha256"},
        "root_prime": {"type": "integer", "minimum": 2},
        "root_primality_verifier_id": {"$ref": "#/$defs/nonemptyText"},
        "root_primality_verifier_artifact_digest": {"$ref": "#/$defs/sha256"},
        "root_primality_replay_digest": {"$ref": "#/$defs/sha256"},
        "natural_gap_start": {"const": 3},
        "natural_gap_stop": {"type": "integer", "minimum": 3},
        "natural_gap_step": {"const": 4},
        "natural_gap_count": {"type": "integer", "minimum": 1},
        "checked_gap_count": {"type": "integer", "minimum": 1},
        "checked_divisor_count": {"type": "integer", "minimum": 1},
        "hit_count": {"const": 0},
        "range_definition_id": {"$ref": "#/$defs/nonemptyText"},
        "range_definition_digest": {"$ref": "#/$defs/sha256"},
        "scan_algorithm_id": {"$ref": "#/$defs/nonemptyText"},
        "scan_algorithm_digest": {"$ref": "#/$defs/sha256"},
        "factorization_verifier_id": {"$ref": "#/$defs/nonemptyText"},
        "factorization_verifier_digest": {"$ref": "#/$defs/sha256"},
        "factorization_manifest_digest": {"$ref": "#/$defs/sha256"},
        "divisor_lattice_manifest_digest": {"$ref": "#/$defs/sha256"},
        "scan_transcript_digest": {"$ref": "#/$defs/sha256"},
        "reverse_equivalence_claim_id": {"$ref": "#/$defs/nonemptyText"},
        "reverse_equivalence_claim_digest": {"$ref": "#/$defs/sha256"},
        "reverse_equivalence_proof_id": {"$ref": "#/$defs/nonemptyText"},
        "reverse_equivalence_proof_digest": {"$ref": "#/$defs/sha256"},
        "reverse_equivalence_verifier_id": {"$ref": "#/$defs/nonemptyText"},
        "reverse_equivalence_verifier_digest": {"$ref": "#/$defs/sha256"},
        "reverse_equivalence_replay_digest": {"$ref": "#/$defs/sha256"},
        "global_exhaustion": {"const": true},
        "outcome": {"const": "TERMINAL_UNIVERSE_MISS_EVIDENCE_ONLY"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
