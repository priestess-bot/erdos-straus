{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/priestess-bot/erdos-straus/schemas/t6-gate0-run-provenance-v1.schema.json",
  "title": "T6 Gate-0 run locator or verified GitHub provenance v1",
  "oneOf": [
    {"$ref": "#/$defs/locator"},
    {"$ref": "#/$defs/provenance"}
  ],
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256Prefixed": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "repository",
        "workflow_id",
        "workflow_path",
        "run_id",
        "run_attempt",
        "job_id",
        "artifact_id",
        "artifact_name"
      ],
      "properties": {
        "schema_id": {"const": "t6_gate0_run_locator_v1"},
        "schema_version": {"const": 1},
        "repository": {"const": "priestess-bot/erdos-straus"},
        "workflow_id": {"const": 321454335},
        "workflow_path": {
          "const": ".github/workflows/research-kb-ci.yml"
        },
        "run_id": {"$ref": "#/$defs/positiveInteger"},
        "run_attempt": {"$ref": "#/$defs/positiveInteger"},
        "job_id": {"$ref": "#/$defs/positiveInteger"},
        "artifact_id": {"$ref": "#/$defs/positiveInteger"},
        "artifact_name": {"const": "ci-run-manifest-v1.json"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "source",
        "repository",
        "repository_id",
        "workflow_id",
        "workflow_name",
        "workflow_path",
        "workflow_state",
        "run_id",
        "run_attempt",
        "run_head_sha",
        "run_event",
        "run_head_branch",
        "head_repository_id",
        "gate_zero_success_basis",
        "job_id",
        "job_name",
        "job_status",
        "job_conclusion",
        "artifact_id",
        "artifact_name",
        "artifact_expired",
        "artifact_expires_at",
        "artifact_size_in_bytes",
        "artifact_digest",
        "artifact_workflow_run_id",
        "artifact_workflow_run_head_sha"
      ],
      "properties": {
        "schema_id": {"const": "t6_gate0_run_provenance_v1"},
        "schema_version": {"const": 1},
        "source": {"const": "GITHUB_REST_API"},
        "repository": {"const": "priestess-bot/erdos-straus"},
        "repository_id": {"const": 1313520032},
        "workflow_id": {"const": 321454335},
        "workflow_name": {"const": "T6 Gate 0 and research knowledge base"},
        "workflow_path": {
          "const": ".github/workflows/research-kb-ci.yml"
        },
        "workflow_state": {"const": "active"},
        "run_id": {"$ref": "#/$defs/positiveInteger"},
        "run_attempt": {"$ref": "#/$defs/positiveInteger"},
        "run_head_sha": {"$ref": "#/$defs/gitSha"},
        "run_event": {"const": "push"},
        "run_head_branch": {"const": "main"},
        "head_repository_id": {"const": 1313520032},
        "gate_zero_success_basis": {
          "const": "GATE_ZERO_JOB_COMPLETED_SUCCESS"
        },
        "job_id": {"$ref": "#/$defs/positiveInteger"},
        "job_name": {"const": "gate-zero"},
        "job_status": {"const": "completed"},
        "job_conclusion": {"const": "success"},
        "artifact_id": {"$ref": "#/$defs/positiveInteger"},
        "artifact_name": {"const": "ci-run-manifest-v1.json"},
        "artifact_expired": {"const": false},
        "artifact_expires_at": {"type": "string", "format": "date-time"},
        "artifact_size_in_bytes": {"$ref": "#/$defs/positiveInteger"},
        "artifact_digest": {"$ref": "#/$defs/sha256Prefixed"},
        "artifact_workflow_run_id": {"$ref": "#/$defs/positiveInteger"},
        "artifact_workflow_run_head_sha": {"$ref": "#/$defs/gitSha"}
      }
    }
  }
}
