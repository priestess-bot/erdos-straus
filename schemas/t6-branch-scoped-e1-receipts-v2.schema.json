{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/priestess-bot/erdos_straus/schemas/t6-branch-scoped-e1-receipts-v2.schema.json",
  "title": "T6 Branch-Scoped E1 Zero-Authority Receipt Foundation V2",
  "oneOf": [
    {"$ref": "#/$defs/BranchSelectionReceiptV2"},
    {"$ref": "#/$defs/E1OccurrenceReceiptV2"},
    {"$ref": "#/$defs/E1IndependentReplayReceiptV2"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "positiveVersion": {"type": "integer", "minimum": 1},
    "pathSegment": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "integer", "minimum": 0}
      ]
    },
    "pureJson": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/pureJson"}},
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/pureJson"}
        }
      ]
    },
    "sourceStatePayload": {
      "type": "object",
      "required": ["state_id"],
      "properties": {
        "state_id": {
          "type": "string",
          "pattern": "^state:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": {"$ref": "#/$defs/pureJson"}
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_index",
        "decision_id",
        "decision_kind",
        "decision_contract_digest",
        "producer_id",
        "producer_digest",
        "branch_id",
        "branch_contract_digest",
        "expected_occurrence_path",
        "expected_occurrence_path_digest"
      ],
      "properties": {
        "decision_index": {"type": "integer", "minimum": 0},
        "decision_id": {"$ref": "#/$defs/identifier"},
        "decision_kind": {"enum": ["TERMINAL", "PRODUCER"]},
        "decision_contract_digest": {"$ref": "#/$defs/digest"},
        "producer_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
        },
        "producer_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "branch_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
        },
        "branch_contract_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "expected_occurrence_path": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/pathSegment"}
            }
          ]
        },
        "expected_occurrence_path_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"decision_kind": {"const": "TERMINAL"}}},
          "then": {
            "properties": {
              "producer_id": {"const": null},
              "producer_digest": {"const": null},
              "branch_id": {"const": null},
              "branch_contract_digest": {"const": null},
              "expected_occurrence_path": {"const": null},
              "expected_occurrence_path_digest": {"const": null}
            }
          },
          "else": {
            "properties": {
              "producer_id": {"$ref": "#/$defs/identifier"},
              "producer_digest": {"$ref": "#/$defs/digest"},
              "branch_id": {"$ref": "#/$defs/identifier"},
              "branch_contract_digest": {"$ref": "#/$defs/digest"},
              "expected_occurrence_path": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/pathSegment"}
              },
              "expected_occurrence_path_digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      ]
    },
    "policyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_type",
        "schema_version",
        "head_sha",
        "head_tree_sha",
        "source_state_id",
        "source_state_digest",
        "source_owner_id",
        "source_owner_digest",
        "owner_domain_id",
        "owner_domain_digest",
        "coordinator_route_registry_id",
        "coordinator_route_registry_version",
        "coordinator_route_registry_digest",
        "policy_id",
        "policy_version",
        "decisions",
        "global_exhaustion",
        "digest"
      ],
      "properties": {
        "policy_type": {"const": "BranchDecisionPolicyV2"},
        "schema_version": {"const": 2},
        "head_sha": {"$ref": "#/$defs/gitOid"},
        "head_tree_sha": {"$ref": "#/$defs/gitOid"},
        "source_state_id": {"$ref": "#/$defs/identifier"},
        "source_state_digest": {"$ref": "#/$defs/digest"},
        "source_owner_id": {"$ref": "#/$defs/identifier"},
        "source_owner_digest": {"$ref": "#/$defs/digest"},
        "owner_domain_id": {"$ref": "#/$defs/identifier"},
        "owner_domain_digest": {"$ref": "#/$defs/digest"},
        "coordinator_route_registry_id": {"$ref": "#/$defs/identifier"},
        "coordinator_route_registry_version": {
          "$ref": "#/$defs/positiveVersion"
        },
        "coordinator_route_registry_digest": {"$ref": "#/$defs/digest"},
        "policy_id": {"$ref": "#/$defs/identifier"},
        "policy_version": {"$ref": "#/$defs/positiveVersion"},
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/decision"}
        },
        "global_exhaustion": {"const": false},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "priorDecisionReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "schema_version",
        "source_state_id",
        "source_state_digest",
