        "expected_occurrence_path_digest",
        "replay_outcome",
        "replay_result_digest",
        "replayer_id",
        "replayer_digest",
        "replay_complete",
        "authority",
        "digest"
      ],
      "properties": {
        "evidence_type": {"const": "PriorDecisionReplayEvidenceV2"},
        "schema_version": {"const": 2},
        "source_state_id": {"$ref": "#/$defs/identifier"},
        "source_state_digest": {"$ref": "#/$defs/digest"},
        "policy_id": {"$ref": "#/$defs/identifier"},
        "policy_version": {"$ref": "#/$defs/positiveVersion"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "decision_id": {"$ref": "#/$defs/identifier"},
        "decision_index": {"type": "integer", "minimum": 0},
        "decision_kind": {"enum": ["TERMINAL", "PRODUCER"]},
        "decision_contract_digest": {"$ref": "#/$defs/digest"},
        "producer_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
        },
        "producer_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "branch_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]
        },
        "branch_contract_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "expected_occurrence_path": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/pathSegment"}
            }
          ]
        },
        "expected_occurrence_path_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "replay_outcome": {"enum": ["TERMINAL_MISS", "GUARD_FALSE"]},
        "replay_result_digest": {"$ref": "#/$defs/digest"},
        "replayer_id": {"$ref": "#/$defs/identifier"},
        "replayer_digest": {"$ref": "#/$defs/digest"},
        "replay_complete": {"const": true},
        "authority": {"const": false},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision_kind": {"const": "TERMINAL"}}},
          "then": {
            "properties": {
              "producer_id": {"const": null},
              "producer_digest": {"const": null},
              "branch_id": {"const": null},
              "branch_contract_digest": {"const": null},
              "expected_occurrence_path": {"const": null},
              "expected_occurrence_path_digest": {"const": null},
              "replay_outcome": {"const": "TERMINAL_MISS"}
            }
          },
          "else": {
            "properties": {
              "producer_id": {"$ref": "#/$defs/identifier"},
              "producer_digest": {"$ref": "#/$defs/digest"},
              "branch_id": {"$ref": "#/$defs/identifier"},
              "branch_contract_digest": {"$ref": "#/$defs/digest"},
              "expected_occurrence_path": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/pathSegment"}
              },
              "expected_occurrence_path_digest": {"$ref": "#/$defs/digest"},
              "replay_outcome": {"const": "GUARD_FALSE"}
            }
          }
        }
      ]
    },
    "selectedBranchGuardReplay": {
      "type": "object",
      "additionalProperties": false,
