    "repository_authority": {"const": false},
    "common_owner_authority": {"const": false},
    "registered_prefix_miss_authority": {"const": false},
    "scope_validation_authority": {"const": false},
    "root_source_occurrence_authority": {"const": false},
    "terminal_receipt_direct_continuation_authority": {"const": false},
    "e1_authority": {"const": false}, "generic_e1": {"const": false},
    "successor_e1": {"const": false}, "producer_authority": {"const": false},
    "producer_continuation_allowed": {"const": false}, "admission_authority": {"const": false},
    "persistent_admission": {"const": false}, "queue_authority": {"const": false},
    "enqueue_authority": {"const": false}, "e2_authority": {"const": false},
    "e3_authority": {"const": false}, "e4_authority": {"const": false},
    "e5_authority": {"const": false}, "t5_ticket_authority": {"const": false},
    "t5_potential_authority": {"const": false}, "reentry_authority": {"const": false},
    "terminal_leaf_authority": {"const": false},
    "receipt_id": {"type": "string", "pattern": "^q1-root-source-scoped-e1-rebind:[0-9a-f]{64}$"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "mapping": {"type": "object"},
    "coordinates": {"type": "array", "prefixItems": [
      {"type": "integer", "minimum": 2}, {"const": 3}, {"const": 0},
      {"const": 0}, {"const": 0}, {"const": 0}, {"const": 0}
    ], "items": false, "minItems": 7, "maxItems": 7},
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["grant_id", "role", "artifact_id", "artifact_path", "artifact_symbols", "capabilities", "authority_class", "artifact_semantic_sha256"],
      "properties": {
        "grant_id": {"const": "q1_root_source_scoped_e1_rebind_grant_v1"},
        "role": {"const": "INDEPENDENT_Q1_ROOT_SOURCE_SCOPED_E1_REBINDER"},
        "artifact_id": {"const": "q1_root_source_scoped_e1_rebind_v1"},
        "artifact_path": {"const": "scripts/t6_q_one_root_source_scoped_e1_rebind_v1.py"},
        "artifact_symbols": {"const": ["rebind_q_one_root_source_scoped_e1_v1", "root_source_scoped_e1_rebind_receipt_to_mapping_v1"]},
        "capabilities": {"const": ["REBIND_ROOT_SOURCE_SCOPED_E1_TO_V1_BASE_SOURCE"]},
        "authority_class": {"const": "HEAD_BOUND_EXECUTABLE_CAPABILITY_V6"},
        "artifact_semantic_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "potential": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_version", "state_id", "coordinates", "digest"],
      "properties": {
        "schema_id": {"const": "t5_n7_potential_receipt_v1"},
        "schema_version": {"const": 1},
        "state_id": {"type": "string", "pattern": "^state:[0-9a-f]{64}$"},
        "coordinates": {"$ref": "#/$defs/coordinates"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
