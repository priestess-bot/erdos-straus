    "source_potential_coordinates": {"$ref": "#/$defs/coordinates"},
    "source_rebind_map": {"$ref": "#/$defs/mapping"},
    "source_rebind_map_digest": {"$ref": "#/$defs/digest"},
    "semantic_origin_exclusion_digest": {"$ref": "#/$defs/digest"},
