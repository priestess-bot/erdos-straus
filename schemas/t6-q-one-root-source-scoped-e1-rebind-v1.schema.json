    "source_owner": {"const": "type_ii_relation_g_endpoint"},
    "source_owner_id": {"type": "string", "pattern": "^owner:[0-9a-f]{64}$"},
    "source_owner_digest": {"$ref": "#/$defs/digest"},
    "source_facts_digest": {"$ref": "#/$defs/digest"},
    "owner_contract_id": {"const": "t6_persistent_selector_state_v1"},
    "owner_contract_schema_version": {"const": 1},
    "owner_precedence_index": {"const": 2},
    "v4_owner_receipt_id": {"type": "string", "pattern": "^q1-common-root-owner:[0-9a-f]{64}$"},
    "v4_owner_receipt_digest": {"$ref": "#/$defs/digest"},
    "v1_owner_digest": {"type": "string", "pattern": "^owner:[0-9a-f]{64}$"},
    "v3_terminal_receipt_id": {"type": "string", "pattern": "^production-q1-prefix-miss:[0-9a-f]{64}$"},
