{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://priestess-bot.github.io/erdos-straus/schemas/t6-q-one-root-v1-base-admission-v1.schema.json",
  "title": "q=1 root V1 base materialization and admission receipts",
  "oneOf": [
    { "$ref": "#/$defs/terminalProjection" },
    { "$ref": "#/$defs/materialization" },
    { "$ref": "#/$defs/admission" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mapping": { "type": "object" },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id", "role", "artifact_id", "artifact_path",
        "artifact_symbols", "capabilities", "authority_class",
        "artifact_semantic_sha256"
      ],
      "properties": {
        "grant_id": { "type": "string" },
        "role": { "type": "string" },
        "artifact_id": { "type": "string" },
        "artifact_path": { "type": "string" },
        "artifact_symbols": { "type": "array", "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "authority_class": { "const": "HEAD_BOUND_EXECUTABLE_CAPABILITY_V5" },
        "artifact_semantic_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "terminalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type", "schema_version", "status", "artifact_class",
        "source_state_id", "source_state_digest", "root_actualness_id",
        "root_actualness_digest", "v3_terminal_receipt_id",
        "v3_terminal_receipt_digest", "root_context", "coverage_semantics",
        "ordered_gaps", "next_unchecked_gap", "global_exhaustion",
        "v1_terminal_first", "v1_terminal_first_digest",
        "projection_binding_digest", "terminal_projection_authority",
        "persistent_admission", "queue_authority", "successor_authority",
        "e1_authority", "e2_authority", "e3_authority", "e4_authority",
        "e5_authority", "receipt_id", "digest"
      ],
      "properties": {
        "receipt_type": { "const": "Q1_V3_MISS_TO_V1_TERMINAL_FIRST_PROJECTION_V1" },
        "schema_version": { "const": 1 },
        "status": { "const": "V1_TERMINAL_FIRST_PROJECTED_NO_AUTHORITY" },
        "artifact_class": { "const": "CANONICAL_PROJECTION_ONLY" },
        "source_state_id": { "type": "string", "pattern": "^state:[0-9a-f]{64}$" },
        "source_state_digest": { "$ref": "#/$defs/digest" },
        "root_actualness_id": { "type": "string", "pattern": "^q1-root-source-actualness:[0-9a-f]{64}$" },
        "root_actualness_digest": { "$ref": "#/$defs/digest" },
        "v3_terminal_receipt_id": { "type": "string", "pattern": "^production-q1-prefix-miss:[0-9a-f]{64}$" },
        "v3_terminal_receipt_digest": { "$ref": "#/$defs/digest" },
        "root_context": { "type": "integer", "minimum": 2 },
        "coverage_semantics": { "const": "REGISTERED_PRIORITY_ONLY" },
        "ordered_gaps": { "const": [3, 7, 11] },
        "next_unchecked_gap": { "const": 15 },
        "global_exhaustion": { "const": false },
        "v1_terminal_first": { "$ref": "#/$defs/mapping" },
        "v1_terminal_first_digest": { "$ref": "#/$defs/digest" },
        "projection_binding_digest": { "$ref": "#/$defs/digest" },
        "terminal_projection_authority": { "const": false },
        "persistent_admission": { "const": false },
        "queue_authority": { "const": false },
        "successor_authority": { "const": false },
        "e1_authority": { "const": false },
        "e2_authority": { "const": false },
        "e3_authority": { "const": false },
        "e4_authority": { "const": false },
        "e5_authority": { "const": false },
        "receipt_id": { "type": "string", "pattern": "^q1-v1-terminal-projection:[0-9a-f]{64}$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type", "schema_version", "status", "role", "role_grant",
        "role_grant_id", "role_grant_digest", "role_artifact_id",
        "role_artifact_semantic_sha256", "raw_q_one_g", "raw_q_one_g_digest",
        "source_body", "body_id", "body_digest", "root_anchor", "anchor_id",
        "anchor_digest", "source_state", "source_state_id", "source_state_digest",
        "root_actualness", "root_actualness_id", "root_actualness_digest",
        "terminal_receipt", "terminal_receipt_id", "terminal_receipt_digest",
        "terminal_projection", "terminal_projection_id", "terminal_projection_digest",
        "producer_rule", "producer_rule_digest", "semantic_origin_digest",
        "v1_state", "v1_state_id", "v1_state_wire_digest",
        "canonical_root_potential_evidence", "canonical_root_potential_evidence_digest",
        "local_grant_authenticates_head", "repository_authority",
        "root_base_materialization_authority", "v1_base_owner_authority",
        "root_base_admission_authority", "persistent_admission", "queue_authority",
        "enqueue_authority", "enqueue_performed", "successor_admission",
        "producer_authority", "producer_continuation_allowed", "e1_authority",
        "e2_authority", "e3_authority", "e4_authority", "e5_authority",
        "t5_ticket_authority", "t5_potential_authority", "global_exhaustion", "terminal_leaf_authority",
        "receipt_id", "digest"
      ],
      "properties": {
        "receipt_type": { "const": "Q1_ROOT_V1_BASE_MATERIALIZATION_RECEIPT_V1" },
        "schema_version": { "const": 1 },
        "status": { "const": "V1_ROOT_INITIALIZER_OUTPUT_MATERIALIZED_NOT_ADMITTED" },
        "role": { "const": "Q1_ROOT_V1_BASE_MATERIALIZER" },
        "role_grant": { "$ref": "#/$defs/grant" },
        "role_grant_id": { "const": "q1_root_v1_base_materializer_grant_v1" },
        "role_grant_digest": { "$ref": "#/$defs/digest" },
        "role_artifact_id": { "const": "q1_root_v1_base_materializer_v1" },
        "role_artifact_semantic_sha256": { "$ref": "#/$defs/digest" },
        "raw_q_one_g": { "$ref": "#/$defs/mapping" },
        "raw_q_one_g_digest": { "$ref": "#/$defs/digest" },
        "source_body": { "$ref": "#/$defs/mapping" },
        "body_id": { "type": "string" },
        "body_digest": { "$ref": "#/$defs/digest" },
        "root_anchor": { "$ref": "#/$defs/mapping" },
        "anchor_id": { "type": "string" },
        "anchor_digest": { "$ref": "#/$defs/digest" },
        "source_state": { "$ref": "#/$defs/mapping" },
        "source_state_id": { "type": "string" },
        "source_state_digest": { "$ref": "#/$defs/digest" },
        "root_actualness": { "$ref": "#/$defs/mapping" },
        "root_actualness_id": { "type": "string" },
        "root_actualness_digest": { "$ref": "#/$defs/digest" },
        "terminal_receipt": { "$ref": "#/$defs/mapping" },
        "terminal_receipt_id": { "type": "string" },
        "terminal_receipt_digest": { "$ref": "#/$defs/digest" },
        "terminal_projection": { "$ref": "#/$defs/terminalProjection" },
        "terminal_projection_id": { "type": "string" },
        "terminal_projection_digest": { "$ref": "#/$defs/digest" },
        "producer_rule": { "$ref": "#/$defs/mapping" },
        "producer_rule_digest": { "$ref": "#/$defs/digest" },
        "semantic_origin_digest": { "$ref": "#/$defs/digest" },
        "v1_state": { "$ref": "#/$defs/mapping" },
        "v1_state_id": { "type": "string", "pattern": "^state:[0-9a-f]{64}$" },
        "v1_state_wire_digest": { "$ref": "#/$defs/digest" },
        "canonical_root_potential_evidence": {
          "type": "array", "prefixItems": [
            { "type": "integer", "minimum": 2 }, { "const": 3 }, { "const": 0 },
            { "const": 0 }, { "const": 0 }, { "const": 0 }, { "const": 0 }
          ], "items": false, "minItems": 7, "maxItems": 7
        },
        "canonical_root_potential_evidence_digest": { "$ref": "#/$defs/digest" },
        "local_grant_authenticates_head": { "const": false },
        "repository_authority": { "const": false },
        "root_base_materialization_authority": { "const": true },
        "v1_base_owner_authority": { "const": false },
        "root_base_admission_authority": { "const": false },
        "persistent_admission": { "const": false },
        "queue_authority": { "const": false },
        "enqueue_authority": { "const": false },
        "enqueue_performed": { "const": false },
        "successor_admission": { "const": false },
        "producer_authority": { "const": false },
        "producer_continuation_allowed": { "const": false },
        "e1_authority": { "const": false },
        "e2_authority": { "const": false },
        "e3_authority": { "const": false },
        "e4_authority": { "const": false },
        "e5_authority": { "const": false },
        "t5_ticket_authority": { "const": false },
        "t5_potential_authority": { "const": false },
        "global_exhaustion": { "const": false },
        "terminal_leaf_authority": { "const": false },
        "receipt_id": { "type": "string", "pattern": "^q1-v1-root-materialization:[0-9a-f]{64}$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_type", "schema_version", "status", "role", "role_grant",
        "role_grant_id", "role_grant_digest", "role_artifact_id",
        "role_artifact_semantic_sha256", "materialization_receipt",
        "materialization_receipt_id", "materialization_receipt_digest",
        "v4_owner_receipt", "v4_owner_receipt_id", "v4_owner_receipt_digest",
        "v4_scope_receipt", "v4_scope_receipt_id", "v4_scope_receipt_digest",
        "source_state_id", "source_state_digest", "v1_contract_id",
        "v1_state_schema_id", "v1_state_schema_version", "v1_state",
        "v1_state_id", "v1_state_wire_digest", "canonical_root_potential_evidence",
        "canonical_root_potential_evidence_digest", "local_grant_authenticates_head",
        "repository_authority", "producer_rule",
        "producer_rule_digest", "verified_header", "verified_header_digest",
        "family_precedence", "family_precedence_digest", "predicate_results",
        "predicate_results_digest", "matched_families", "owner",
        "precedence_index", "v4_owner_id", "v4_owner_digest",
        "v1_owner_digest", "owner_translation_binding_digest",
        "admission_decision", "admission_reason",
        "root_base_materialization_authority", "v1_base_owner_authority",
        "root_base_admission_authority", "persistent_admission", "queue_authority",
        "enqueue_authority", "enqueue_performed", "successor_admission",
        "producer_authority", "producer_continuation_allowed",
        "generic_owner_authority", "e1_authority", "e2_authority",
        "e3_authority", "e4_authority", "e5_authority",
        "t5_ticket_authority", "t5_potential_authority", "global_exhaustion",
        "terminal_leaf_authority", "receipt_id", "digest"
      ],
      "properties": {
        "receipt_type": { "const": "Q1_ROOT_V1_BASE_ADMISSION_RECEIPT_V1" },
        "schema_version": { "const": 1 },
        "status": { "const": "V1_ROOT_INITIALIZER_BASE_ADMISSION_ISSUED_NO_QUEUE" },
        "role": { "const": "INDEPENDENT_Q1_ROOT_V1_BASE_ADMISSION_VERIFIER" },
        "role_grant": { "$ref": "#/$defs/grant" },
        "role_grant_id": { "const": "q1_root_v1_base_admission_verifier_grant_v1" },
        "role_grant_digest": { "$ref": "#/$defs/digest" },
        "role_artifact_id": { "const": "q1_root_v1_base_admission_verifier_v1" },
        "role_artifact_semantic_sha256": { "$ref": "#/$defs/digest" },
        "materialization_receipt": { "$ref": "#/$defs/materialization" },
        "materialization_receipt_id": { "type": "string" },
        "materialization_receipt_digest": { "$ref": "#/$defs/digest" },
        "v4_owner_receipt": { "$ref": "#/$defs/mapping" },
        "v4_owner_receipt_id": { "type": "string" },
        "v4_owner_receipt_digest": { "$ref": "#/$defs/digest" },
        "v4_scope_receipt": { "$ref": "#/$defs/mapping" },
        "v4_scope_receipt_id": { "type": "string" },
        "v4_scope_receipt_digest": { "$ref": "#/$defs/digest" },
        "source_state_id": { "type": "string" },
        "source_state_digest": { "$ref": "#/$defs/digest" },
        "v1_contract_id": { "const": "t6_persistent_selector_state_v1" },
        "v1_state_schema_id": { "const": "persistent_selector_state_v1" },
        "v1_state_schema_version": { "const": 1 },
        "v1_state": { "$ref": "#/$defs/mapping" },
        "v1_state_id": { "type": "string", "pattern": "^state:[0-9a-f]{64}$" },
        "v1_state_wire_digest": { "$ref": "#/$defs/digest" },
        "canonical_root_potential_evidence": {
          "type": "array", "prefixItems": [
            { "type": "integer", "minimum": 2 }, { "const": 3 }, { "const": 0 },
            { "const": 0 }, { "const": 0 }, { "const": 0 }, { "const": 0 }
          ], "items": false, "minItems": 7, "maxItems": 7
        },
        "canonical_root_potential_evidence_digest": { "$ref": "#/$defs/digest" },
        "local_grant_authenticates_head": { "const": false },
        "repository_authority": { "const": false },
        "producer_rule": { "$ref": "#/$defs/mapping" },
        "producer_rule_digest": { "$ref": "#/$defs/digest" },
        "verified_header": { "$ref": "#/$defs/mapping" },
        "verified_header_digest": { "$ref": "#/$defs/digest" },
        "family_precedence": { "type": "array", "items": { "type": "string" }, "minItems": 15, "maxItems": 15 },
        "family_precedence_digest": { "$ref": "#/$defs/digest" },
        "predicate_results": { "$ref": "#/$defs/mapping" },
        "predicate_results_digest": { "$ref": "#/$defs/digest" },
        "matched_families": { "const": ["type_ii_relation_g_endpoint"] },
        "owner": { "const": "type_ii_relation_g_endpoint" },
        "precedence_index": { "const": 2 },
        "v4_owner_id": { "type": "string" },
        "v4_owner_digest": { "$ref": "#/$defs/digest" },
        "v1_owner_digest": { "type": "string", "pattern": "^owner:[0-9a-f]{64}$" },
        "owner_translation_binding_digest": { "$ref": "#/$defs/digest" },
        "admission_decision": { "const": "ACCEPT" },
        "admission_reason": { "const": "ACCEPT" },
        "root_base_materialization_authority": { "const": false },
        "v1_base_owner_authority": { "const": true },
        "root_base_admission_authority": { "const": true },
        "persistent_admission": { "const": true },
        "queue_authority": { "const": false },
        "enqueue_authority": { "const": false },
        "enqueue_performed": { "const": false },
        "successor_admission": { "const": false },
        "producer_authority": { "const": false },
        "producer_continuation_allowed": { "const": false },
        "generic_owner_authority": { "const": false },
        "e1_authority": { "const": false },
        "e2_authority": { "const": false },
        "e3_authority": { "const": false },
        "e4_authority": { "const": false },
        "e5_authority": { "const": false },
        "t5_ticket_authority": { "const": false },
        "t5_potential_authority": { "const": false },
        "global_exhaustion": { "const": false },
        "terminal_leaf_authority": { "const": false },
        "receipt_id": { "type": "string", "pattern": "^q1-v1-root-base-admission:[0-9a-f]{64}$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
